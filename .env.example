# Environment Configuration Template
# Copy this file to .env and configure local environment overrides.
# NOTE: Never commit sensitive credentials or api keys to version control.

# Application Environment (development, testing, production)
APP_ENV=development

# Base Paths (Optional overrides; defaults to repository structure)
# DATA_DIR=./data
# MODEL_DIR=./models

# Dashboard Server Settings
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# Model Training Parameters
RANDOM_SEED=42
N_JOBS=-1
